<?xml version="1.0"?>
<!--
  A UR arm on a pedestal with an ultrasonic + IR sensor bracket on its tool flange.

  The arm looks straight down at a box on the floor (see worlds/fusion_lab.sdf)
  and moves the sensors towards and away from it.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur_fusion">
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="pedestal_height" default="0.6"/>
  <xacro:arg name="sim_gazebo" default="true"/>
  <xacro:arg name="initial_positions_file"
             default="$(find ur_fusion_description)/config/initial_positions.yaml"/>
  <xacro:arg name="controllers_file"
             default="$(find ur_fusion_description)/config/ur_controllers.yaml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_fusion_description)/urdf/sensor_bracket.xacro"/>
  <xacro:include filename="$(find ur_fusion_description)/urdf/ur_fusion_gazebo.xacro"/>

  <xacro:property name="pedestal_height" value="$(arg pedestal_height)"/>

  <link name="world"/>

  <link name="pedestal">
    <visual>
      <origin xyz="0 0 ${pedestal_height / 2}"/>
      <geometry>
        <box size="0.3 0.3 ${pedestal_height}"/>
      </geometry>
      <material name="pedestal_grey">
        <color rgba="0.33 0.35 0.38 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${pedestal_height / 2}"/>
      <geometry>
        <box size="0.3 0.3 ${pedestal_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${pedestal_height / 2}"/>
      <mass value="40.0"/>
      <inertia ixx="1.5" iyy="1.5" izz="0.6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="world-pedestal" type="fixed">
    <parent link="world"/>
    <child link="pedestal"/>
  </joint>

  <xacro:ur_robot
    name="ur"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    force_abs_paths="true">
    <origin xyz="0 0 ${pedestal_height}" rpy="0 0 0"/>
  </xacro:ur_robot>

  <xacro:sensor_bracket parent="tool0"/>

  <xacro:if value="$(arg sim_gazebo)">
    <xacro:ur_fusion_gazebo
      initial_positions="${xacro.load_yaml('$(arg initial_positions_file)')}"
      controllers_file="$(arg controllers_file)"/>
  </xacro:if>
</robot>
