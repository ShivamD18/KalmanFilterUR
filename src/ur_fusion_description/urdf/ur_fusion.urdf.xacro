<?xml version="1.0"?>
<!--
  A UR arm on a 1.30 m steel riser with an ultrasonic + IR sensor bracket on its
  tool flange.

  The arm looks straight down at a part on a conveyor (see workcell.urdf.xacro)
  and moves the sensors towards and away from it.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur_fusion">
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="pedestal_height" default="1.30"/>
  <xacro:arg name="sim_gazebo" default="true"/>
  <xacro:arg name="initial_positions_file"
             default="$(find ur_fusion_description)/config/initial_positions.yaml"/>
  <xacro:arg name="controllers_file"
             default="$(find ur_fusion_description)/config/ur_controllers.yaml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_fusion_description)/urdf/sensor_bracket.xacro"/>
  <xacro:include filename="$(find ur_fusion_description)/urdf/ur_fusion_gazebo.xacro"/>

  <xacro:property name="pedestal_height" value="$(arg pedestal_height)"/>

  <material name="riser_column">
    <color rgba="0.22 0.24 0.27 1"/>
  </material>
  <material name="riser_plate">
    <color rgba="0.48 0.49 0.51 1"/>
  </material>

  <link name="world"/>

  <!-- Steel riser: anchored base plate, square column, top plate the arm bolts to. -->
  <xacro:macro name="riser_part" params="xyz size material">
    <visual>
      <origin xyz="${xyz}"/>
      <geometry>
        <box size="${size}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>
  <xacro:macro name="anchor_bolt" params="x y">
    <visual>
      <origin xyz="${x} ${y} 0.03"/>
      <geometry>
        <cylinder radius="0.012" length="0.012"/>
      </geometry>
      <material name="riser_plate"/>
    </visual>
  </xacro:macro>

  <link name="pedestal">
    <xacro:riser_part xyz="0 0 0.0125" size="0.42 0.42 0.025" material="riser_plate"/>
    <xacro:riser_part xyz="0 0 ${pedestal_height / 2}"
                      size="0.20 0.20 ${pedestal_height - 0.04}" material="riser_column"/>
    <xacro:riser_part xyz="0 0 ${pedestal_height - 0.01}" size="0.26 0.26 0.02"
                      material="riser_plate"/>
    <xacro:anchor_bolt x="0.17" y="0.17"/>
    <xacro:anchor_bolt x="-0.17" y="0.17"/>
    <xacro:anchor_bolt x="0.17" y="-0.17"/>
    <xacro:anchor_bolt x="-0.17" y="-0.17"/>
    <collision>
      <origin xyz="0 0 ${pedestal_height / 2}"/>
      <geometry>
        <box size="0.20 0.20 ${pedestal_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${pedestal_height / 2}"/>
      <mass value="60.0"/>
      <inertia ixx="8.5" iyy="8.5" izz="0.4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="world-pedestal" type="fixed">
    <parent link="world"/>
    <child link="pedestal"/>
  </joint>

  <xacro:ur_robot
    name="ur"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    force_abs_paths="true">
    <origin xyz="0 0 ${pedestal_height}" rpy="0 0 0"/>
  </xacro:ur_robot>

  <xacro:sensor_bracket parent="tool0"/>

  <xacro:if value="$(arg sim_gazebo)">
    <xacro:ur_fusion_gazebo
      initial_positions="${xacro.load_yaml('$(arg initial_positions_file)')}"
      controllers_file="$(arg controllers_file)"/>
  </xacro:if>
</robot>
